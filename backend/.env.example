# ==== Core ====
ENVIRONMENT=development
# Demo không Docker: SQLite (bảng tự tạo khi khởi động).
DATABASE_URL=sqlite+aiosqlite:///./smartstudy.db
# Production / docker-compose: dùng PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://smartstudy:smartstudy@localhost:5432/smartstudy
# Supabase trên mạng chỉ có IPv4: dùng Session pooler (không phải cổng 6543).
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
AUTH_PROVIDER=local
JWT_SECRET=change-me-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=*
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ==== Supabase Auth (đặt AUTH_PROVIDER=supabase) ====
# Publishable key chỉ dùng phía server; không đưa vào mobile.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chỉ cần cho project cũ còn ký access token bằng HS256.
SUPABASE_JWT_SECRET=

# ==== MQTT ====
MQTT_ENABLED=true
# Broker công khai cho demo: Wokwi web không truy cập được localhost/IP LAN.
# Nếu chạy Mosquitto trong docker-compose, đổi thành MQTT_HOST=localhost.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
# Phải trùng TOPIC_PREFIX trong firmware/config.h.
# Demo dùng chuỗi ngẫu nhiên để không đụng topic của người khác trên broker công khai.
MQTT_TOPIC_PREFIX=smartstudy_demo_2f7c91

# ==== IoT ====
DEVICE_OFFLINE_AFTER_SECONDS=90
ALERT_COOLDOWN_SECONDS=600

# ==== AI (server-side only, never ship this key in the mobile app) ====
# auto: Groq -> Gemini -> rule-based
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==== Demo ====
SEED_DEMO=false
LOG_LEVEL=INFO
