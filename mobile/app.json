{
  "expo": {
    "name": "Smart Learning Assistant",
    "slug": "smart-learning-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "smartstudy",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartstudy.assistant",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.smartstudy.assistant",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#0F766E",
          "defaultChannel": "study-alerts-v2"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép Smart Learning Assistant dùng micro để nhận lệnh giọng nói.",
          "speechRecognitionPermission": "Cho phép Smart Learning Assistant nhận diện giọng nói để điều khiển thiết bị."
        }
      ]
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
